{% extends 'layout.twig' %}

{% block body %}
  <!-- ======= Header ======= -->
  <header id="header">
    <div class="container">
      <h1><a href="#" title="Magnificent">Mou<span class="special" title="Youthful">Y</span>ahada I<span class="special" title="Youthful">sm</span>a<span class="special" title="Youthful">il</span></a></h1>

      <!-- Uncomment below if you prefer to use an image logo -->
      <!-- <a href="index.html" class="mr-auto"><img src="assets/img/logo.png" alt="" class="img-fluid"></a> -->
      <h2>Je suis un <span title="Concepteur et developpeur d'application" data-toggle="tooltip" data-placement="top" class="special-slim">Concepteur et developpeur d'application</span> passioné, curieux et créatif</h2>

      <nav id="navbar" class="navbar">
        <ul>
          <li>
            <a class="nav-link active" href="#header">Accueil</a>
          </li>
          <li>
            <a class="nav-link" href="#about">Sur moi</a>
          </li>
          <li>
            <a class="nav-link" href="#resume">Résumé</a>
          </li>
          <li>
            <a class="nav-link" href="#services">Préstations</a>
          </li>
          <li>
            <a class="nav-link" href="#portfolio">Portfolio</a>
          </li>
          <li>
            <a class="nav-link" href="#contact">Contact</a>
          </li>
        </ul>
        <i class="bi bi-list mobile-nav-toggle"></i>
      </nav>
      <!-- .navbar -->

      <div class="social-links">
        {% for item in reseaux.data %}
          <a href="{{ item.lien }}" class="{{ item.icon }}"><i class="bi bi-{{ item.icon }}"></i></a>
        {% endfor %}
      </div>
    </div>
  </header>
  <!-- End Header -->

  <!-- ======= About Section ======= -->
  <section id="about" class="about">
    <!-- ======= About Me ======= -->
    <div class="about-me container">
      <div class="section-title">
        <h2>Identité</h2>
        <p>I.MOUYAHADA</p>
      </div>

      <div class="row">
        <div class="col-lg-4 img-profil-container" data-aos="fade-right ">
          <img src="assets/img/me.png" class="img-fluid img-profil" alt="" />
        </div>
        <div class="col-lg-8 pt-4 pt-lg-0 content" data-aos="fade-left">
          <h3>Concepteur &amp; Développeur informatique</h3>
          <p class="fst-italic">{{ acceuil.data.description_inrtoduction }}</p>
          <div class="row">
            <div class="col-lg-6">
              <ul>
                <li>
                  <i class="bi bi-chevron-right"></i> <strong>Date de naissance:</strong> <span>{{ acceuil.data.date_naissance }}</span>
                </li>
                <li>
                  <i class="bi bi-chevron-right"></i> <strong>Site web:</strong> <span>{{ acceuil.data.site_web }}</span>
                </li>
                <li>
                  <i class="bi bi-chevron-right"></i> <strong>Mobile:</strong> <span>{{ acceuil.data.mobile }}</span>
                </li>
                <li>
                  <i class="bi bi-chevron-right"></i> <strong>Ville:</strong> <span>{{ acceuil.data.ville }}</span>
                </li>
              </ul>
            </div>
            <div class="col-lg-6">
              <ul>
                <li>
                  <i class="bi bi-chevron-right"></i> <strong>Age:</strong> <span>{{ acceuil.data.age }} ans</span>
                </li>
                <li>
                  <i class="bi bi-chevron-right"></i> <strong>Qualification:</strong> <span>{{ acceuil.data.qualification }}</span>
                </li>
                <li>
                  <i class="bi bi-chevron-right"></i> <strong>Adresse E-mail:</strong>
                  <span>{{ acceuil.data.email }}</span>
                </li>
                <li>
                  <i class="bi bi-chevron-right"></i> <strong>Freelance:</strong> <span>{{ acceuil.data.disponibilite ? 'Indisponible Actuellement' : 'Disponible pour des messions' }}</span>
                </li>
              </ul>
            </div>
          </div>
          <p>{{ acceuil.data.description_profil }}</p>
        </div>
      </div>
    </div>
    <!-- End About Me -->

    <!-- ======= Counts ======= -->
    <div class="counts container">
      <div class="row">
        {% for item in statistiques.data %}
          <div class="col-lg-3 col-md-6">
            <div class="count-box">
              <i class="{{ item.icon }}"></i>
              <span data-purecounter-start="0" data-purecounter-end="{{ item.valeur }}" data-purecounter-duration="1" class="purecounter"></span>
              <p>{{ item.nom }}</p>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
    <!-- End Counts -->

    <!-- ======= Compétences techniques ======= -->
    <div class="skills container">
      <div class="section-title">
        <h2>Compétences techniques</h2>
      </div>

      <div class="row skills-content">
        {% for item in languages_inforamtiques.data %}
          <div class="col-lg-6">
            <div class="progress">
              <span class="skill"><i class="{{ item.icon }} colored"></i> {{ item.nom_language }} <i class="val">{{ item.percentage_maitrise }}%</i></span>
              <div class="progress-bar-wrap">
                <div class="progress-bar" role="progressbar" aria-valuenow="{{ item.percentage_maitrise }}" aria-valuemin="0" aria-valuemax="100"></div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
    <!-- Fin des Compétences techniques -->

    <!-- ======= Frameworks ======= -->
    <div class="skills container">
      <div class="section-title">
        <h2>Technologies de spécialisations</h2>
      </div>

      <div class="row skills-content">
        {% for item in frameworks.data %}
          <div class="col-lg-6">
            <div class="progress">
              <span class="skill"><i class="{{ item.icon }} colored"></i> {{ item.nom_framework }} <i class="val">{{ item.percentage_maitrise }}%</i></span>
              <div class="progress-bar-wrap">
                <div class="progress-bar" role="progressbar" aria-valuenow="{{ item.percentage_maitrise }}" aria-valuemin="0" aria-valuemax="100"></div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
    <!-- End Skills -->

    <!-- ======= Centre d'Interêts ======= -->
    <div class="interests container">
      <div class="section-title">
        <h2>Centres d'Intérêts</h2>
      </div>

      <div class="row">
        {% for item in centres_intrets.data %}
          <div class="col-lg-3 col-md-4 my-4 mt-md-0">
            <div class="icon-box">
              <i class="{{ item.icon }}" style="color: #4ceb95;"></i>
              <h3>{{ item.nom_intret }}</h3>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
    <!-- Fin des Centres d'Intérêts -->

    <!-- ======= Testimonials ======= -->
    <div class="testimonials container">
      <div class="section-title">
        <h2>Témoignages de mes supérieurs</h2>
      </div>

      <div class="testimonials-slider swiper" data-aos="fade-up" data-aos-delay="100">
        <div class="swiper-wrapper">
          {% for item in temoignages.data %}
            <div class="swiper-slide">
              <div class="testimonial-item">
                <p>
                  <i class="bx bxs-quote-alt-left quote-icon-left"></i>
                  {{ item.description }}
                  <i class="bx bxs-quote-alt-right quote-icon-right"></i>
                </p>
                <img src="{{ assetPath }}{{ item.profil }}" class="testimonial-img" alt="{{ item.titre }}" />
                <h3>{{ item.titre }}</h3>
                <h4>{{ item.titulaire }}</h4>
              </div>
            </div>
          {% endfor %}
          <!-- End testimonial item -->
        </div>
        <div class="swiper-pagination"></div>
      </div>

      <div class="owl-carousel testimonials-carousel"></div>
    </div>
    <!-- End Testimonials -->
  </section>
  <!-- End About Section -->

  <!-- ======= Resume Section ======= -->
  <section id="resume" class="resume">
    <div class="container">
      <div class="section-title">
        <h2>Curriculum vitae</h2>
        <p>CONSULTER MON CV</p>
      </div>

      <div class="row">
        <div class="col-lg-6">
          <h3 class="resume-title">Résumé</h3>
          <div class="resume-item pb-0">
            <h4>{{ resumee.data.titulaire }}</h4>
            <div>{{ resumee.data.description }}</div>
          </div>
          <h3 class="resume-title">Études</h3>
          {% for item in etudes.data %}
            <div class="resume-item">
              <h4>{{ item.titre }}</h4>
              <h5>{{ item.peroide }}</h5>
              <p>
                <em>{{ item.site }}</em>
              </p>
              <p>
                <em>{{ item.description }}</em>
              </p>
            </div>
          {% endfor %}
        </div>
        <div class="col-lg-6">
          <h3 class="resume-title">Expérience professionnelle</h3>

          {% for item in experiences_professionnels.data %}
            <div class="resume-item">
              <h4>{{ item.titulaire }}</h4>
              <h5>{{ item.peroide }}</h5>
              <p>
                <em>{{ item.site }}</em>
              </p>
              <div>{{ item.description }}</div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>
  <!-- Fin de la section Curriculum vitae -->
  <!-- End Resume Section -->

  <!-- ======= Section des Services ======= -->
  <section id="services" class="services">
    <div class="container">
      <div class="section-title">
        <h2>Nos Services</h2>
        <p>Découvrez ce que nous offrons</p>
      </div>

      <div class="row">
        {% for item in services.data %}
          <div class="col-lg-4 col-md-6 d-flex align-items-stretch my-4 mt-md-0">
            <div class="icon-box">
              <div class="icon">
                <i class="{{ item.icon }}"></i>
              </div>
              <h4><a href="">{{ item.titre }}</a></h4>
              <p>{{ item.resumee }}</p>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>
  <!-- Fin de la Section des Services -->

  <!-- ======= Portfolio Section ======= -->
  <!-- ======= Portfolio Section ======= -->
  <section id="portfolio" class="portfolio">
    <div class="container">
      <div class="section-title">
        <h2>Portfolio</h2>
        <p>Mes travaux</p>
      </div>

      <div class="row">
        <div class="col-lg-12 d-flex justify-content-center">
          <ul id="portfolio-flters">
            <li data-filter="*" class="filter-active">Tout</li>
            <li data-filter=".filter-mobile">Mobile</li>
            <li data-filter=".filter-web">Web</li>
            <li data-filter=".filter-desktop">Desktop</li>
            <li data-filter=".filter-open-source">Open Source</li>
          </ul>
        </div>
      </div>

      <div class="row portfolio-container">
        {% for item in projects.data %}
          <div class="col-lg-4 col-md-6 portfolio-item filter-{{ item.type }}">
            <div class="portfolio-wrap">
              <img src="{{ assetPath }}{{ item.screen }}" class="img-fluid" alt="{{ item.nom_projet }}" />
              <div class="portfolio-info">
                <h4>{{ item.titre_projet }}</h4>
                <p>{{ item.description }}</p>
                <div class="portfolio-links">
                  <a href="{{ assetPath }}{{ item.screen }}" data-gallery="portfolioGallery" class="portfolio-lightbox" title="{{ item.nom_projet }}"><i class="bx bx-plus"></i></a>
                  <a href="/details/projet/{{ item.id }}" data-gallery="portfolioDetailsGallery" data-glightbox="type: external" class="portfolio-details-lightbox" title="Portfolio Details"><i class="bx bx-link"></i></a>
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>
  <!-- End Portfolio Section -->

  <!-- End Portfolio Section -->

  <!-- ======= Contact Section ======= -->
  <section id="contact" class="contact">
    <div class="container">
      <div class="section-title">
        <h2>Contact</h2>
        <p>ME REJOINDRE</p>
      </div>

      <div class="row mt-2">
        <div class="col-md-6 d-flex align-items-stretch">
          <div class="info-box">
            <i class="bx bx-map"></i>
            <h3>Géolocalisation</h3>
            <p>{{ acceuil.data.ville }}</p>
          </div>
        </div>

        <div class="col-md-6 mt-4 mt-md-0 d-flex align-items-stretch">
          <div class="info-box">
            <i class="bx bx-share-alt"></i>
            <h3>Réseaux Sociaux</h3>
            <div class="social-links">
              {% for item in reseaux.data %}
                <a href="{{ item.lien }}" class="{{ item.icon }}"><i class="bi bi-{{ item.icon }}"></i></a>
              {% endfor %}
            </div>
          </div>
        </div>

        <div class="col-md-6 mt-4 d-flex align-items-stretch">
          <div class="info-box">
            <i class="bx bx-envelope"></i>
            <h3>M'adresser un mail</h3>
            <p>{{ acceuil.data.email }}</p>
          </div>
        </div>
        <div class="col-md-6 mt-4 d-flex align-items-stretch">
          <div class="info-box">
            <i class="bx bx-phone-call"></i>
            <h3>Me télephoner</h3>
            <p>{{ acceuil.data.mobile }}</p>
          </div>
        </div>
      </div>

      <form action="/" method="post" role="form" class="php-email-form mt-4">
        <div class="row">
          <div class="col-md-6 form-group">
            <input type="text" name="nom" class="form-control" id="nom" placeholder="Votre Nom" required />
          </div>
          <div class="col-md-6 form-group mt-3 mt-md-0">
            <input type="email" class="form-control" name="email" id="email" placeholder="Votre Email" required />
          </div>
        </div>
        <div class="form-group mt-3">
          <input type="text" class="form-control" name="sujet" id="sujet" placeholder="Sujet" required />
        </div>
        <div class="form-group mt-3">
          <textarea class="form-control" name="message" rows="5" placeholder="Message" required></textarea>
        </div>
        <div class="my-3">
          <div class="loading">Chargement</div>
          <div class="error-message"></div>
          <div class="sent-message">Votre message a été envoyé. Merci !</div>
        </div>
        <div class="text-center">
          <button type="submit">Envoyer le Message</button>
        </div>
      </form>
    </div>
  </section>

  <!-- End Contact Section -->

  <div class="credits">
    Toues les droits sont réservés <a href="https://ismail-mouyahada.com/">ISMAIL MOUYAHADA</a>
  </div>
{% endblock %}
